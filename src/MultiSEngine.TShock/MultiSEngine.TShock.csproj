<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>MultiSEngine.TShock</AssemblyName>
    <RootNamespace>MultiSEngine.TShock</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TShock" Version="6.2.1" ExcludeAssets="runtime;contentFiles" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MultiSEngine.Protocol\CustomPackets\CustomPacketCodec.cs" Link="Protocol\CustomPacketCodec.cs" />
  </ItemGroup>

</Project>
